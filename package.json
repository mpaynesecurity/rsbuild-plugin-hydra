{
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"init": "bun install",
		"build": "bunx --bun rsbuild build",
		"clean": "rm bun.lock  && rm -rf node_modules && bun run --filter '*' clean",
		"docs:dev": "bun run --filter 'pkg-docs' dev",
		"sandbox:bun": "bunx --bun rsbuild",
		"sandbox:node": "rsbuild",
		"sandbox:build": "bunx --bun rsbuild build",
		"sandbox:build:rsdoctor": "RSDOCTOR=true bunx --bun rsbuild build",
		"plugin:build": "bun run --filter '*/rsbuild-plugin-hydra' build && bun i",
		"plugin:build:rsdoctor": "bun run --filter '*/rsbuild-plugin-hydra' build:rsdoctor",
		"preview:cf": "wrangler dev",
		"preview:bun": "bun dist/index.mjs"
	},
	"workspaces": [
		"plugin",
		"sandbox",
		"docs"
	],
	"catalog": {
		"@hono/node-server": "^2.0.8",
		"@hono/valibot-validator": "^0.6.1",
		"@rsbuild/core": "^2.1.8",
		"@rsbuild/plugin-babel": "^2.0.1",
		"@rsbuild/plugin-solid": "^1.2.2",
		"@rsbuild/plugin-tailwindcss": "^2.0.3",
		"@rsdoctor/rspack-plugin": "^1.6.1",
		"@rslib/core": "^0.23.2",
		"@scalar/hono-api-reference": "^0.11.9",
		"@shikijs/transformers": "^4.3.1",
		"@solidjs/router": "^0.16.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@valibot/to-json-schema": "^1.7.1",
		"fast-glob": "^3.3.3",
		"hono": "^4.12.29",
		"hono-openapi": "^1.3.1",
		"jsdom": "^29.1.1",
		"magic-string": "^0.30.21",
		"ofetch": "^1.5.1",
		"openapi-types": "^12.1.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"solid-js": "^1.9.14",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"@hono/structured-logger": "^0.1.0",
		"pino": "^10.3.1"
	},
	"dependencies": {
		"@hono/valibot-validator": "^0.6.1",
		"@scalar/hono-api-reference": "^0.11.11",
		"@valibot/to-json-schema": "^1.7.1",
		"hono": "^4.12.32",
		"hono-openapi": "^1.3.1",
		"ofetch": "^1.5.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@mpaynesecurity/rsbuild-plugin-hydra": "workspace:*",
		"@rsbuild/core": "^2.1.8",
		"@rsbuild/plugin-babel": "^2.0.1",
		"@rsbuild/plugin-solid": "^1.2.2",
		"@rsbuild/plugin-tailwindcss": "^2.0.3",
		"@rslib/core": "^0.23.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@types/systeminformation": "^3.54.1",
