{
	"private": true,
	"type": "module",
	"scripts": {
		"init": "bun install",
		"clean:artifacts": "rm -rf .wrangler && rm -rf dist",
		"clean:deps": "rm bun.lock && rm -rf node_modules && bun run --filter '*' clean",
		"docs:dev": "bun run --elide-lines=0 --filter 'pkg-docs' dev",
		"docs:build": "bun run --elide-lines=0 --filter 'pkg-docs' build",
		"sandbox:dev": "bun --bun rsbuild",
		"sandbox:build": "bun --bun rsbuild build",
		"sandbox:build:rsdoctor": "RSDOCTOR=true bun --bun rsbuild build",
		"plugin:build": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-hydra' build && bun i",
		"plugin:build:rsdoctor": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-hydra' build:rsdoctor",
		"preview:build": "bun run plugin:build && bun run sandbox:build && bun run preview:bun",
		"preview": "bun dist/index.mjs",
		"preview:cf": "wrangler dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mpaynesecurity/rsbuild-plugin-hydra.git"
	},
	"keywords": [
		"Hono",
		"fullstack",
		"file system routing"
	],
	"workspaces": {
		"packages": [
			"plugin",
			"sandbox"
		],
		"catalog": {
			"@solidjs/router": "^0.16.1",
			"cross-env": "^10.1.0",
			"magic-string": "^1.3.1",
			"solid-js": "^1.9.14",
			"typescript": "^6.0.3",
			"zod": "^4.4.3"
		},
		"catalogs": {
			"hono": {
				"hono": "^4.13.7"
			},
			"rstack": {
				"@rsbuild/core": "^2.2.1",
				"@rsbuild/plugin-babel": "^2.0.1",
				"@rsbuild/plugin-solid": "^1.2.2",
				"@rsbuild/plugin-tailwindcss": "^2.0.3",
				"@rslib/core": "^1.0.0",
				"@rsdoctor/rspack-plugin": "^1.6.1"
			},
			"types": {
				"@types/bun": "^1.4.2",
				"@types/node": "^26.1.1"
			}
		}
	},
	"dependencies": {
		"@mpaynesecurity/rsbuild-plugin-hydra": "workspace:*"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:rstack",
		"@rsbuild/plugin-babel": "catalog:rstack",
		"@rsbuild/plugin-solid": "catalog:rstack",
		"@rsbuild/plugin-tailwindcss": "catalog:rstack",
		"@rsdoctor/rspack-plugin": "catalog:rstack",
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"cross-env": "catalog:",
		"tailwindcss": "^4.3.1",
		"typescript": "catalog:",
		"wrangler": "^4.114.0"
	},
	"peerDependencies": {
		"typescript": "catalog:",
		"solid-js": "catalog:",
		"@solidjs/router": "catalog:",
		"hono": "catalog:hono",
		"zod": "catalog:",
		"@hono/zod-validator": "^0.9.1"
	}
}
