{
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"init": "bun install",
		"build": "bunx --bun rsbuild build",
		"clean": "rm bun.lock  && rm -rf node_modules && bun run --filter '*' clean",
		"docs:dev": "bun run --filter 'pkg-docs' dev",
		"sandbox:bun": "bunx --bun rsbuild",
		"sandbox:node": "rsbuild",
		"plugin:build": "bun run --filter '*/rsbuild-plugin-hydra' build",
		"preview:cf": "wrangler dev",
		"preview:bun": "bun dist/index.mjs"
	},
	"workspaces": [
		"plugin",
		"sandbox",
		"docs"
	],
	"catalog": {
		"@hono/node-server": "^2.0.8",
		"@hono/standard-validator": "^0.2.3",
		"@hono/valibot-validator": "^0.6.1",
		"@rsbuild/core": "^2.1.4",
		"@rsbuild/plugin-babel": "^2.0.1",
		"@rsbuild/plugin-solid": "^1.2.2",
		"@rsbuild/plugin-tailwindcss": "^2.0.3",
		"@rslib/core": "^0.23.2",
		"@scalar/hono-api-reference": "^0.11.9",
		"@shikijs/transformers": "^4.3.1",
		"@solidjs/router": "^0.16.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@valibot/to-json-schema": "^1.7.1",
		"fast-glob": "^3.3.3",
		"hono": "^4.12.29",
		"hono-openapi": "^1.3.1",
		"jsdom": "^29.1.1",
		"magic-string": "^0.30.21",
		"solid-js": "^1.9.14",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@mpaynesecurity/rsbuild-plugin-hydra": "workspace:*",
		"@rsbuild/core": "catalog:",
		"@rsbuild/plugin-babel": "catalog:",
		"@rsbuild/plugin-solid": "catalog:",
		"@rsbuild/plugin-tailwindcss": "catalog:",
		"@rslib/core": "catalog:",
		"@rspress/plugin-typedoc": "^2.0.17",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"solid-js": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"wrangler": "^4.110.0"
	}
}
