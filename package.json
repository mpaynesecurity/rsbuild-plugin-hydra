{
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"init": "bun install",
		"clean": "rm bun.lock && rm -rf node_modules && bun run --filter '*' clean",
		"docs:dev": "bun run --elide-lines=0 --filter 'pkg-docs' dev",
		"docs:build": "bun run --elide-lines=0 --filter 'pkg-docs' build",
		"sandbox:dev": "bun --bun rsbuild",
		"sandbox:build": "bun --bun rsbuild build",
		"sandbox:build:rsdoctor": "RSDOCTOR=true bun --bun rsbuild build",
		"plugin:build": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-hydra' build && bun i",
		"plugin:build:rsdoctor": "bun run --elide-lines=0 --filter '*/rsbuild-plugin-hydra' build:rsdoctor",
		"preview:cf": "wrangler dev",
		"preview:bun": "bun dist/index.mjs"
	},
	"workspaces": {
		"packages": [
			"plugin",
			"sandbox",
			"public-docs"
		],
		"catalog": {
			"@solidjs/router": "^0.16.1",
			"cross-env": "^10.1.0",
			"pino": "^10.3.1",
			"solid-js": "^1.9.14",
			"typescript": "^6.0.3",
			"zod": "^4.4.3"
		},
		"catalogs": {
			"hono": {
				"@hono/structured-logger": "^0.1.0",
				"@hono/valibot-validator": "^0.6.1",
				"@hono/standard-validator": "^0.3.0",
				"@scalar/hono-api-reference": "^0.11.9",
				"hono": "^4.12.29",
				"hono-openapi": "^1.3.1"
			},
			"rstack": {
				"@rsbuild/core": "^2.1.8",
				"@rsbuild/plugin-babel": "^2.0.1",
				"@rsbuild/plugin-solid": "^1.2.2",
				"@rsbuild/plugin-tailwindcss": "^2.0.3",
				"@rslib/core": "^0.23.2",
				"@rsdoctor/rspack-plugin": "^1.6.1",
				"@rspress/core": "^2.0.18",
				"@shikijs/transformers": "^4.3.1",
				"react": "^19.2.7",
				"react-dom": "^19.2.7"
			},
			"unjs": {
				"magic-string": "^0.30.21",
				"pathe": "^2.0.3",
				"std-env": "^4.2.0",
				"consola": "^3.4.2"
			},
			"types": {
				"@types/react": "^19.2.17",
				"@types/react-dom": "^19.2.3",
				"@types/bun": "^1.3.14",
				"@types/node": "^26.1.1",
				"openapi-types": "^12.1.3"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/payneusmc07/rsbuild-plugin-hydra.git"
	},
	"dependencies": {
		"@mpaynesecurity/rsbuild-plugin-hydra": "workspace:*",
		"@hono/valibot-validator": "catalog:hono",
		"@scalar/hono-api-reference": "catalog:hono",
		"hono": "catalog:hono",
		"openapi-types": "catalog:types",
		"hono-openapi": "catalog:hono",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:rstack",
		"@rsbuild/plugin-babel": "catalog:rstack",
		"@rsbuild/plugin-tailwindcss": "catalog:rstack",
		"@rsbuild/plugin-solid": "catalog:rstack",
		"@rsdoctor/rspack-plugin": "catalog:rstack",
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"solid-js": "catalog:",
		"tailwindcss": "^4.3.1",
		"typescript": "catalog:",
		"wrangler": "^4.114.0",
		"cross-env": "catalog:"
	},
	"peerDependencies": {
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"typescript": "catalog:"
	}
}
