{
	"name": "@mpaynesecurity/rsbuild-plugin-hydra",
	"version": "1.0.1",
	"type": "module",
	"scripts": {
		"build:rsdoctor": "cross-env RSDOCTOR=true rslib",
		"build": "NODE_ENV=development rslib",
		"clean": "rm -rf node_modules",
		"publish:staged": "npm stage publish",
		"publish:git": "npm publish --registry=https://npm.pkg.github.com"
	},
	"dependencies": {
		"hono": "catalog:hono",
		"magic-string": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.1",
		"@rsdoctor/rspack-plugin": "catalog:rstack",
		"@rslib/core": "catalog:rstack",
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"cross-env": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"typescript": "catalog:"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": false
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/payneusmc07/rsbuild-plugin-hydra.git",
		"directory": "plugin"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./env": {
			"types": "./dist/env/index.d.ts",
			"import": "./dist/env/index.js"
		}
	}
}
