{
	"name": "@mpaynesecurity/rsbuild-plugin-hydra",
	"version": "1.0.2",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"Hono",
		"full stack",
		"file system routing"
	],
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/mpaynesecurity"
	},
	"scripts": {
		"build:rsdoctor": "cross-env RSDOCTOR=true rslib",
		"build": "cross-env NODE_ENV=development rslib",
		"clean": "rm -rf node_modules",
		"publish:local": "npm publish --registry https://registry.mpaynesecurity.net",
		"unpublish:local": "npm unpublish @mpaynesecurity/rsbuild-plugin-hydra --registry https://registry.mpaynesecurity.net --force",
		"publish:git": "npm publish --registry https://npm.pkg.github.com --no-workspaces"
	},
	"dependencies": {
		"hono": "catalog:hono",
		"magic-string": "catalog:"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.2",
		"@rsdoctor/rspack-plugin": "catalog:rstack",
		"@rslib/core": "catalog:rstack",
		"cross-env": "catalog:"
	},
	"peerDependencies": {
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"typescript": "catalog:"
	},
	"peerDependenciesMeta": {
		"@types/bun": {
			"optional": false
		},
		"@types/node": {
			"optional": false
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mpaynesecurity/rsbuild-plugin-hydra.git",
		"directory": "plugin"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		}
	}
}
