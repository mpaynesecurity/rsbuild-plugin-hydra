{
	"name": "@mpaynesecurity/rsbuild-plugin-hydra",
	"type": "module",
	"scripts": {
		"build:rsdoctor": "cross-env RSDOCTOR=true rslib",
		"build": "rslib",
		"clean": "rm -rf node_modules"
	},
	"dependencies": {
		"consola": "catalog:unjs",
		"hono": "catalog:hono",
		"magic-string": "catalog:unjs",
		"pathe": "catalog:unjs",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:rstack",
		"@rslib/core": "catalog:rstack",
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"cross-env": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"typescript": "catalog:"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": false
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/payneusmc07/rsbuild-plugin-hydra.git",
		"directory": "plugin"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./env": {
			"types": "./dist/env/index.d.ts",
			"import": "./dist/env/index.js"
		},
		"./logger": {
			"types": "./dist/logger/index.d.ts",
			"import": "./dist/logger/index.js"
		}
	}
}
