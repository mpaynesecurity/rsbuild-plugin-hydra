{
	"name": "@mpaynesecurity/rsbuild-plugin-hydra",
	"type": "module",
	"scripts": {
		"build:rsdoctor": "cross-env RSDOCTOR=true rslib",
		"build": "rslib",
		"clean": "rm -rf node_modules"
	},
	"dependencies": {
		"hono": "catalog:",
		"@hono/node-server": "catalog:",
		"fast-glob": "catalog:",
		"magic-string": "catalog:",
		"ofetch": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"@rsdoctor/rspack-plugin": "catalog:",
		"cross-env": "^10.1.0"
	},
	"peerDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": false
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./env": {
			"types": "./dist/env/index.d.ts",
			"import": "./dist/env/index.js"
		}
	}
}
